{
  "name": "n8n-workflow-kit",
  "version": "0.1.0",
  "description": "n8n workflows as TypeScript: tested Code-node modules, deterministic builds, validation, deploy with drift detection and rollback.",
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "build": "tsx kit/cli.ts build",
    "validate": "tsx kit/cli.ts validate",
    "typecheck": "tsc --noEmit",
    "kit": "tsx kit/cli.ts"
  },
  "author": "Kyrylo Kalashnyk",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@n8n/workflow-sdk": "0.36.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
